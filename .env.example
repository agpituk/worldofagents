# Copy this file to `.env` and tweak as needed. `.env` is gitignored.

# Shared secret used by world-api and llm-gateway to sign/verify gateway tokens.
# Both services MUST share the same value. Change this in any deployment.
ARENA_SHARED_SECRET=change-me-in-prod-this-is-the-trust-anchor

# --- Host-side ports ---------------------------------------------------------
# Ports services bind on the HOST. Picked deliberately uncommon to avoid
# clashes with other local services. Inside the docker network, services
# still talk to each other on their normal ports (5432, 6379, 8000, 8001).
POSTGRES_HOST_PORT=47432
REDIS_HOST_PORT=47379
WORLD_API_PORT=47800
GATEWAY_PORT=47801
FRONTEND_PORT=47900

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- World API --------------------------------------------------------------
WORLD_TICK_SECONDS=6

# --- LLM Gateway ------------------------------------------------------------
# Provider options: stub | cq | any-llm | llamafile
# - stub      : returns canned responses (no real LLM, useful for CI / first run)
# - llamafile : local llamafile server (set LLAMAFILE_BASE_URL)
# - any-llm   : routes through the any-llm router
# - cq        : routes through cq SDK
GATEWAY_DEFAULT_PROVIDER=stub
LLAMAFILE_BASE_URL=http://host.docker.internal:47080

# Optional provider configs (filled by you when you wire a real provider)
CQ_BASE_URL=
CQ_API_KEY=
ANY_LLM_BASE_URL=

# --- Memory retriever -------------------------------------------------------
# Hero memory has a pluggable retriever. Three backends, in priority order:
#   1. cq-exchange (hosted SaaS, world-shared)
#   2. local cq SDK (per-instance semantic)
#   3. SqlRetriever (default, recency + tag overlap, zero setup)
#
# Default off — the SQL fallback works without any external service.
CQ_ENABLED=0
# CQ_ADDR=http://localhost:3000
# CQ_API_KEY=

# Hosted cq-exchange — world-shared memory across all heroes in a namespace.
# Leave commented unless you have credentials.
# CQ_EXCHANGE_ENABLED=1
# CQ_EXCHANGE_URL=https://your-cq-exchange.example.com
# CQ_EXCHANGE_API_KEY=
# CQ_EXCHANGE_NAMESPACE_ID=
