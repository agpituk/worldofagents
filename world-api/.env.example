# Replace with a fresh random value (>=16 chars). World-api refuses to
# boot if this is unset or matches a known placeholder.
# Generate one with: `python3 -c 'import secrets; print(secrets.token_urlsafe(48))'`
ARENA_SHARED_SECRET=replace-me-with-secrets.token_urlsafe-48
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena
# Pointing at the docker-compose mapped host port. Adjust if you're not using compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=47432
REDIS_HOST=localhost
REDIS_PORT=47379
WORLD_TICK_SECONDS=6
GATEWAY_BASE_URL=http://localhost:47801
